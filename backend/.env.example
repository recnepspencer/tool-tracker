# Local development only. Use separate credentials and DEBUG=0 in deployment.
DJANGO_SECRET_KEY=local-review-only-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
POSTGRES_DB=nelson_review
POSTGRES_USER=nelson
POSTGRES_PASSWORD=local-review-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# Used only by the explicit seed_review_data command.
NELSON_REVIEW_PASSWORD=local-review-login-password

# Frontend origin used in email links and CSRF origin checks.
NELSON_APP_URL=http://127.0.0.1:5173
# DEBUG uses a private file inbox at ../artifacts/mail. Configure SMTP in production.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Nelson Electric <noreply@example.com>
# Only when a trusted ingress overwrites X-Real-IP (see deploy/nginx.conf):
# NELSON_TRUSTED_PROXY_IPS=127.0.0.1
