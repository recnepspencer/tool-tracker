# Local development only. Use separate credentials and DEBUG=0 in deployment.
DJANGO_SECRET_KEY=local-review-only-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
POSTGRES_DB=nelson_review
POSTGRES_USER=nelson
POSTGRES_PASSWORD=local-review-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# Used only by the explicit seed_review_data command.
NELSON_REVIEW_PASSWORD=local-review-login-password
