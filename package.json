{
  "name": "nelson-electric-tool-custody",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src vite.config.ts vitest.config.ts eslint.config.js --max-warnings=0",
    "format": "prettier --write src vite.config.ts vitest.config.ts eslint.config.js .prettierrc.json package.json index.html",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts eslint.config.js .prettierrc.json package.json index.html",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.59.0",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
